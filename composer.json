{
    "name": "cam5/domoarigato",
    "description": "Build HTML in PHP with elements and attributes as objects: escaped by default, every HTML5 element and attribute, and optional content validation.",
    "type": "library",
    "keywords": [
        "html",
        "html5",
        "dom",
        "builder",
        "elements",
        "attributes",
        "escaping",
        "xss",
        "validation"
    ],
    "homepage": "https://github.com/cam5/domoarigato",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Cameron Hurd",
            "homepage": "https://github.com/cam5"
        }
    ],
    "support": {
        "issues": "https://github.com/cam5/domoarigato/issues",
        "source": "https://github.com/cam5/domoarigato"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "infection/infection": "^0.32.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Cam5\\Domoarigato\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cam5\\Domoarigato\\tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "phpunit",
            "bin/check-coverage"
        ],
        "mutate": "infection --threads=max"
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "coverage": "Run the test suite and fail unless line coverage is 100% (needs PCOV or Xdebug).",
        "mutate": "Run mutation testing and fail unless every mutant is killed (needs PCOV or Xdebug)."
    }
}
